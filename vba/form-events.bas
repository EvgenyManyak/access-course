' =====================================================================================
' Каркасы процедур событий для модулей форм (файл к курсу
' «Microsoft Access 2007–2016 для аналитика», модуль 12).
'
' ВНИМАНИЕ: ЭТОТ КОД ВСТАВЛЯЕТСЯ В МОДУЛЬ ФОРМЫ, А НЕ В ОБЫЧНЫЙ МОДУЛЬ!
'   Access ищет обработчики событий (Form_Load, btnOpenOrders_Click) в модуле формы.
'   Если вставить эти процедуры в обычный модуль (Insert → Module) или импортировать
'   файл через File → Import File..., код окажется «отключённым»: события его не вызовут.
'
' КАК ПРАВИЛЬНО ПЕРЕНЕСТИ КОД
'   1. Откройте нужную форму в Конструкторе → F4 (окно свойств) → вкладка «События»
'      → кнопка «...» у нужного события → выберите [Процедура обработки событий].
'      VBE откроет модуль формы и создаст пустую заготовку процедуры с нужным именем.
'   2. Вставьте тело процедуры из этого файла в заготовку (или замените заготовку целиком).
'      Другой путь к модулю формы: в VBE → Project Explorer (Ctrl+R) → раздел
'      Microsoft Access Class Objects → Forms → двойной щелчок по нужной форме.
'
' КАКАЯ ПРОЦЕДУРА В КАКОЙ МОДУЛЬ
'   Form_Load, Form_Current, ShowStats_Immediate
'       — модуль формы frm_Заказы (создана в модуле 9);
'   btnOpenOrders_Click
'       — модуль формы со списком клиентов, например frm_Клиенты (источник — таблица
'         Customers); главное, чтобы на форме был элемент управления CustomerID;
'   UnitPrice_BeforeUpdate
'       — модуль формы frm_Товары (поле UnitPrice добавлено в модуле 9);
'         тот же код подходит и для подчинённой формы sfrm_ПозицииЗаказа.
'
' ПРО ОКНО IMMEDIATE
'   Immediate открывается в VBE сочетанием Ctrl+G: там выполняются выражения после «?»
'   и печатаются результаты Debug.Print (см. ShowStats_Immediate в конце файла).
'
' ПРИМЕЧАНИЕ
'   Строки Option Compare Database и Option Explicit уже есть в шапке каждого модуля
'   формы — при копировании НЕ вставляйте их второй раз (будет ошибка компиляции).
' =====================================================================================

Option Compare Database
Option Explicit

' ---------------------------------------------------------------------------------------------
' 1. Событие «Загрузка» (Load) формы frm_Заказы → модуль frm_Заказы
' ---------------------------------------------------------------------------------------------
Private Sub Form_Load()
    ' Срабатывает ОДИН раз при открытии формы — место для настроек «по умолчанию».
    ' Имя Form_Load Access распознаёт автоматически: в свойстве события «Загрузка»
    ' должно стоять [Процедура обработки событий], вручную вызывать процедуру не нужно.

    Me.Caption = "Заказы — ТехноДом"
    ' Caption — заголовок окна формы: виден на вкладке документа.

    Me.ИтогоЗаказов.Caption = DCount("*", "Orders")
    ' ИтогоЗаказов — надпись (Label) в области заголовка формы frm_Заказы;
    ' DCount считает строки таблицы Orders. Ожидаемый результат: 12 (мини-датасет).
    ' Проверка выражения ДО вставки в форму: откройте Immediate (Ctrl+G),
    ' введите строку ? DCount("*", "Orders") и нажмите Enter — напечатается 12.

End Sub

' ---------------------------------------------------------------------------------------------
' 2. Событие «Текущая запись» (Current) формы frm_Заказы → модуль frm_Заказы
' ---------------------------------------------------------------------------------------------
Private Sub Form_Current()
    ' Срабатывает при каждом переходе на другую запись (и при перечитывании формы).
    ' Надпись ТекущийЗаказ в заголовке формы всегда показывает, с каким заказом работает
    ' пользователь, — аналитик не перепутает записи при прокрутке.

    Me.ТекущийЗаказ.Caption = "Заказ: " & Nz(Me.OrderID, "новый")
    ' Me.OrderID — значение поля OrderID текущей записи (текстовый ключ вида O-10001);
    ' Nz(значение, замена) подставляет «новый», если поле пустое (Null) — курсор стоит
    ' на новой, ещё не сохранённой записи.
    ' Ожидаемо: на первой записи — «Заказ: O-10001», на новой строке — «Заказ: новый».

End Sub

' ---------------------------------------------------------------------------------------------
' 3. Кнопка btnOpenOrders «Заказы клиента» → модуль формы frm_Клиенты
' ---------------------------------------------------------------------------------------------
Private Sub btnOpenOrders_Click()
    ' Открывает frm_Заказы, отфильтрованную по клиенту текущей записи.
    ' Ожидаемый результат: для клиента C-0001 — 3 заказа (O-10001, O-10004, O-10012),
    ' для C-0003 — 2 заказа (O-10003, O-10011), для C-0005 — только отменённый O-10006.

    Dim strWhere As String                ' условие отбора для аргумента WhereCondition

    ' CustomerID — ТЕКСТОВОЕ поле (ключ вида C-0001), поэтому значение оборачивается
    ' в одинарные кавычки ВНУТРИ строки условия. Готовое условие: CustomerID = 'C-0001'
    ' Строка собирается из трёх частей:
    '   "CustomerID = '"   — начало условия с открывающей одинарной кавычкой;
    '   Me.CustomerID      — значение поля формы на текущей записи (C-0001);
    '   "'"                — закрывающая одинарная кавычка.
    ' Для ЧИСЛОВОГО поля (ManagerID = 2) кавычки не нужны:
    '   strWhere = "ManagerID = " & Me.ManagerID
    ' Сообщение «Несоответствие типов данных в выражении условия отбора» (3464)
    ' почти всегда означает: текстовое поле сравнивается без кавычек.

    strWhere = "CustomerID = '" & Me.CustomerID & "'"

    DoCmd.OpenForm "frm_Заказы", acNormal, , strWhere, acFormEdit, acWindowNormal
    ' Разбор аргументов OpenForm:
    '   "frm_Заказы"    — имя открываемой формы;
    '   acNormal        — режим формы (acDesign открыл бы конструктор);
    '   (пустой третий) — имя запроса-фильтра (FilterName): не используется, лишняя запятая;
    '   strWhere        — WhereCondition: условие WHERE без самого слова WHERE;
    '   acFormEdit      — режим данных: разрешено редактирование (acFormReadOnly — только чтение);
    '   acWindowNormal  — обычное окно (acDialog сделал бы форму модальным диалогом).

End Sub

' ---------------------------------------------------------------------------------------------
' 4. Событие «До обновления» (BeforeUpdate) поля UnitPrice → модуль формы frm_Товары
' ---------------------------------------------------------------------------------------------
Private Sub UnitPrice_BeforeUpdate(Cancel As Integer)
    ' Событие срабатывает ПЕРЕД записью изменённого значения в таблицу:
    ' последняя линия защиты, когда данные уже введены, но ещё не сохранены.
    ' Параметр Cancel Access передаёт сам: установите его в True — сохранение отменится.

    If Nz(Me.UnitPrice, 0) < 0 Then
        ' Nz заменяет пустое поле нулём, чтобы сравнение не падало на Null.
        MsgBox "Цена не может быть отрицательной: " & Me.UnitPrice & "." & vbCrLf & _
               "Введите 0 или положительное число.", vbExclamation, "Проверка цены"
        Cancel = True
        ' Cancel = True отменяет сохранение: Access возвращает фокус в поле, значение
        ' остаётся несохранённым (Esc или Me.UnitPrice.Undo откатывают ввод полностью).
        ' Без этой строки MsgBox был бы простым «поворчанием»: пользователь нажмёт ОК,
        ' и отрицательная цена всё равно уйдёт в таблицу.
    End If

End Sub

' ---------------------------------------------------------------------------------------------
' 5. Быстрая статистика для окна Immediate (Ctrl+G) → модуль формы frm_Заказы
' ---------------------------------------------------------------------------------------------
Public Sub ShowStats_Immediate()
    ' Процедура для отладки и самопроверки: печатает контрольные числа датасета в Immediate.
    ' Она Public — видна за пределами модуля формы. Три способа выполнить:
    '   1) курсор внутрь процедуры → F5 (Run → Run Sub/UserForm);
    '   2) в строке Immediate набрать Forms!frm_Заказы.ShowStats_Immediate и нажать Enter
    '      (форма frm_Заказы должна быть открыта: код модуля формы живёт вместе с формой);
    '   3) перенести процедуру в обычный модуль — тогда из Immediate её зовут по простому
    '      имени: ShowStats_Immediate.

    Debug.Print "Заказов в базе: " & DCount("*", "Orders")
    ' Ожидается: 12.

    Debug.Print "Позиций в деталях: " & DCount("*", "OrderDetails")
    ' Ожидается: 15.

    Debug.Print "Выручка, включая отменённые: " & _
                DSum("[Quantity]*[UnitPrice]", "OrderDetails")
    ' Ожидается: 3 115,40 — сумма всех 15 позиций, включая отменённый заказ O-10006.

    Debug.Print "Выручка без отменённых: " & _
                DSum("[Quantity]*[UnitPrice]", "OrderDetails", "OrderID <> 'O-10006'")
    ' Третий аргумент — критерий (WHERE без слова WHERE); отсекаем отменённый O-10006.
    ' Ключ текстовый, поэтому в критерии одинарные кавычки (см. процедуру 3).
    ' Ожидается: 3 025,50 — эталонная сумма курса (сходится с export-examples.bas и модулем 8).

End Sub
